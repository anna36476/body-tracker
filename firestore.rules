rules_version = '2';

// Body & Nutrition Tracker — Firestore security rules
//
// Every signed-in user gets their own document space at
// /users/{their uid}/data/{key}. A user can only ever read or write
// documents under their own uid — Firestore checks this using the
// Firebase ID token sent as a Bearer token on every request from the app.
//
// To apply: Firebase console -> Firestore Database -> Rules -> paste this -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
